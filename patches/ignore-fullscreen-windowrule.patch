 	bool should_init_get_focus =
 		!c->isopensilent &&
@@ -4192,6 +4194,17 @@
 	if (!c || c->iskilling)
 		return;

+	/* Don't let the client drive the window state. Acknowledge the request so
+	 * it renders fullscreen content (video players, games) inside the geometry
+	 * it already has, and leave floating/tiled/fullscreen up to the user. */
+	if (c->ignore_fullscreen) {
+		if (c->isfullscreen)
+			client_set_fullscreen(c, 1);
+		else
+			setfakefullscreen(c, client_wants_fullscreen(c));
+		return;
+	}
+
 	setfullscreen(c, client_wants_fullscreen(c), true);
