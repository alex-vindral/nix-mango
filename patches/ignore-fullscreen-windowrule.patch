-		ignore_maximize, ignore_minimize, idleinhibit_when_focus,
-		vrr_only_fullscreen;
+		ignore_maximize, ignore_minimize, ignore_fullscreen,
+		idleinhibit_when_focus, vrr_only_fullscreen;
